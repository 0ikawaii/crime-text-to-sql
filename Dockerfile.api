FROM python:3.12-slim

WORKDIR /app

# Install CPU-only PyTorch FIRST, from PyTorch's dedicated CPU wheel index.
# Without this, sentence-transformers' plain "torch>=1.11.0" requirement
# resolves via pip's default index, which pulls the full CUDA-enabled build
# (~2GB+ across torch + several nvidia-* packages) even though this image
# has no GPU and will only ever run on CPU. Installing the CPU wheel here
# first means the later `pip install -r requirements-api.txt` sees the
# torch requirement already satisfied and skips reinstalling it.
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu

COPY requirements-api.txt .
RUN pip install --no-cache-dir -r requirements-api.txt

COPY text_to_sql_core.py app.py ./

EXPOSE 8000

CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8000"]